        "build:android": "react-native build-android --extra-params \"--no-daemon --console=plain -PreactNativeArchitectures=arm64-v8a\"",
        "build:ios": "react-native build-ios --mode Debug"
    },
    "dependencies": {
        "@react-native-documents/picker": "patch:@react-native-documents/picker@npm%3A12.0.3#~/.yarn/patches/@react-native-documents-picker-npm-12.0.3-83a7a929fa.patch",
