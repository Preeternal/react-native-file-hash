{
    "name": "@preeternal/react-native-file-hash-macos-example",
    "version": "0.0.1",
    "private": true,
    "codegenConfig": {
        "name": "FileHashMacOSExampleSpec",
        "type": "modules",
        "jsSrcsDir": "specs",
